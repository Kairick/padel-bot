BOT_TOKEN=123456:replace-me
CACHE_TTL_SECONDS=60
LOG_LEVEL=INFO
# Telegram user ids allowed to use /stats, comma separated. Send /stats to the bot to see your id.
ADMIN_IDS=
# Secret key for hashing user ids in stats, never stored in the database: openssl rand -hex 32
STATS_SALT=
# Database file for stats and subscriptions, default: data/stats.sqlite3 in the project folder
# STATS_DB_PATH=data/stats.sqlite3
# Background polling of Reservio for subscriptions to freed courts
# MONITOR_ENABLED=true
# MONITOR_INTERVAL_SECONDS=600
